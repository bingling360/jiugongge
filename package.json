{
  "name": "cube-world-rewrite",
  "version": "3.0.0",
  "private": true,
  "description": "六面立方体魔塔的拓扑、规则与浏览器回归测试",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:watch": "vitest --config vitest.config.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:e2e:list": "playwright test --config playwright.config.js --list",
    "serve": "python3 tests/e2e/server.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "vitest": "^3.2.0"
  }
}
